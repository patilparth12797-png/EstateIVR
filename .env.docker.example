# Copy this file to .env.docker before your first local run.

DRACHTIO_HOST=drachtio
DRACHTIO_PORT=9022
DRACHTIO_SECRET=shadowpbx_drachtio_secret

SIP_DOMAIN=192.168.10.85
SIP_PORT=5060
EXTERNAL_IP=192.168.10.85

RTPENGINE_HOST=rtpengine
RTPENGINE_PORT=22222

MONGODB_URI=mongodb://shadowpbx:shadowpbx123@mongo:27017/shadowpbx?authSource=shadowpbx

RECORDINGS_DIR=/recordings
RECORDING_FORMAT=wav
RECORDING_SPOOL_DIR=/var/spool/rtpengine

API_PORT=3000
ADMIN_SECRET=shadowpbx_admin_api_key
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

MAX_REGISTER_ATTEMPTS=5
REGISTER_BAN_DURATION=300
MAX_REGISTRATION_EXPIRES=300
SIP_RATE_LIMIT=20
LOG_LEVEL=info

MOH_DIR=/app/audio
VOICEMAIL_DIR=/voicemail
VM_BEEP_FILE=/audio/beep.wav
VM_DEFAULT_GREETING=/audio/vm-greeting.wav
VM_MAX_MESSAGE_LENGTH=120

PARK_SLOT_MIN=70
PARK_SLOT_MAX=79

DTMF_LISTEN_PORT=22223
DTMF_LISTEN_HOST=0.0.0.0
APP_DIR=/app
